# Required Microsoft Foundry settings
FOUNDRY_PROJECT_ENDPOINT=https://your-project-endpoint
FOUNDRY_MODEL_DEPLOYMENT_NAME=your-model-deployment
FOUNDRY_PROJECT_KEY=your-project-key
WORKSHOP_AGENT_INSTRUCTIONS=あなたは出張手配を支援するAIアシスタントです。ユーザーの要望に基づいてホテルの検索と出張申請を実施しなさい。出張申請には出張名、出張目的、出張先City名、出張期間、および出張日用の概算が必要です。出張申請を実行する前に必ずユーザーに確認を取りなさい。

# Flask server port
PORT=5000

# Travel Request API endpoint
TRAVEL_REQUEST_API_ENDPOINT=https://travel-request-api:8080/api/travel-requests

# Hotel Search API endpoint
HOTEL_SEARCH_API_ENDPOINT=https://hotel-search-api:8081/api/hotels/search